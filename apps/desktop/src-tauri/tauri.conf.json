{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion",
  "version": "0.1.0",
  "identifier": "com.modiostudio.minify",
  "build": {
    "beforeDevCommand": "pnpm audio:prepare && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm audio:prepare && node src-tauri/scripts/inject-pubkey.js && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Orion",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "resizable": true,
        "maximized": true,
        "transparent": false,
        "alwaysOnTop": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": ["https://*.spotify.com/*"]
      }
    }
  },
  "bundle": {
    "resources": ["resources/audio/**/*"],
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzOTgyRDY4QTQzMDEyQ0MKUldUTUVqQ2thQzJZRTlYZS9QZ1FiVER3dllHVTM3Smd1L3V3M1R1RmZBQ0pVNlhhblEvSHQ0K00K",
      "endpoints": [
        "https://github.com/Skeptic-systems/Orion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
